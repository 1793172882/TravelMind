{
  "servers": {
    "fake": {
      "enabled": false,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "tests.fake_mcp_server"]
    },
    "feishu": {
      "enabled": false,
      "transport": "streamable_http",
      "url_env": "FEISHU_MCP_URL",
      "auth": "feishu_tenant",
      "allowed_tools": ["fetch-doc"]
    },
    "lark_openapi": {
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@larksuiteoapi/lark-mcp@0.5.1", "mcp"],
      "env_from": {
        "APP_ID": "FEISHU_APP_ID",
        "APP_SECRET": "FEISHU_APP_SECRET",
        "LARK_DOMAIN": "FEISHU_LARK_DOMAIN",
        "LARK_TOKEN_MODE": "FEISHU_LARK_TOKEN_MODE",
        "LARK_TOOLS": "FEISHU_LARK_TOOLS"
      }
    }
  }
}
