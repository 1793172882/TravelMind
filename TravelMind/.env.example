# MySQL connection used by FastAPI/SQLAlchemy. Replace every placeholder locally.
DATABASE_URL=mysql+pymysql://travelmind:change-me@127.0.0.1:3306/travelmind?charset=utf8mb4
# Optional. Defaults to DATABASE_URL with the async MySQL driver when omitted.
CHECKPOINT_DATABASE_URL=

# Alibaba Cloud Model Studio (Beijing) through its OpenAI-compatible endpoint.
MODEL_NAME=qwen3.5-plus
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# AMap Web Service key: geocoding, POI, weather and route planning.
AMAP_API_KEY=
AMAP_TIMEOUT_SECONDS=10

# Copy config/mcp.example.json to this path, then enable only available servers.
MCP_CONFIG_PATH=config/mcp.json

# Inbound Feishu Event Subscription verification. Keep secrets only in .env.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_MCP_URL=https://mcp.feishu.cn/mcp

# Example values consumed indirectly by config/mcp.json.
FEISHU_MCP_TOKEN=
